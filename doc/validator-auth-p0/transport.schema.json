{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tos:validator-auth:transport:v1",
  "description": "Duplicate object names MUST be rejected before JSON Schema validation. Byte cap and UTF-8 checked before parsing.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "request_id",
        "request"
      ],
      "properties": {
        "api_version": {
          "const": "1"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})*$",
          "maxLength": 4000000
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "request_id",
        "result",
        "error"
      ],
      "properties": {
        "api_version": {
          "const": "1"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "result": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$",
              "maxLength": 4000000
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$",
              "maxLength": 4000000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "result": {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$",
              "maxLength": 4000000
            },
            "error": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "result": {
              "type": "null"
            },
            "error": {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$",
              "maxLength": 4000000
            }
          }
        }
      ]
    }
  ]
}
