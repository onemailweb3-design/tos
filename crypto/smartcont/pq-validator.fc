;;
;; The post-quantum validator descriptor, as the contracts that produce and consume it
;; need it. Every rule here has a counterpart in the node's decoder: a descriptor this
;; accepts is one the node accepts, and a descriptor this refuses is one the node would
;; have refused after it was already authoritative, which is a halt rather than a bad
;; registration.
;;
;; Requires TVM version 16 for SHA256C. Nothing here verifies a signature; that is
;; PQCHECKSIG_MLDSA44, declared in pq.fc.

;; Admitted suites. One, deliberately: a second algorithm is a protocol change, not a
;; configuration value.
const int pq::algorithm::mldsa44 = 1;
const int pq::mldsa44_public_key_bytes = 1312;
const int pq::bytes_chunk = 127;

;; The post-quantum descriptor's constructor, frozen in TL-B as validator_pq#b3.
const int pq::descriptor_tag = 0xb3;

const int pq::error::tag = 60;
const int pq::error::algorithm = 61;
const int pq::error::key_length = 62;
const int pq::error::malformed_key = 63;
const int pq::error::key_id = 64;
const int pq::error::zero_validator_id = 65;
const int pq::error::zero_adnl = 66;
const int pq::error::zero_weight = 67;

int pq::admitted_algorithm?(int algorithm_id) inline {
  return algorithm_id == pq::algorithm::mldsa44;
}

;; The exact key length a suite has. Zero for anything unadmitted, so a caller that skips
;; the admission check still cannot match a length.
int pq::public_key_bytes(int algorithm_id) inline {
  return algorithm_id == pq::algorithm::mldsa44 ? pq::mldsa44_public_key_bytes : 0;
}

;; Walks a stored chain and returns the bytes it carries, refusing anything that is not
;; the canonical shape: byte-aligned cells, at most one continuation each, every chunk but
;; the last exactly full, and a last chunk that is neither empty nor oversized.
;;
;; This matters beyond tidiness. The hash does not depend on where the boundaries fall, so
;; a non-canonical chain would derive the same identity while serialising to different
;; bytes -- and the node refuses those bytes.
int pq::chain_bytes(cell chain) {
  int total = 0;
  int walking = -1;
  while (walking) {
    slice cs = chain.begin_parse();
    int bits = cs.slice_bits();
    int refs = cs.slice_refs();
    throw_if(pq::error::malformed_key, bits & 7);
    throw_if(pq::error::malformed_key, refs > 1);
    int bytes = bits >> 3;
    if (refs == 1) {
      throw_unless(pq::error::malformed_key, bytes == pq::bytes_chunk);
      chain = cs~load_ref();
    } else {
      throw_unless(pq::error::malformed_key, (bytes > 0) & (bytes <= pq::bytes_chunk));
      walking = 0;
    }
    total += bytes;
  }
  return total;
}

;; The stored form of a key: a length in its own cell, and a reference to the chain that
;; carries the bytes. The length is checked against the suite before anything is hashed.
(int, cell) pq::stored_key(int algorithm_id, cell stored) {
  throw_unless(pq::error::algorithm, pq::admitted_algorithm?(algorithm_id));
  slice cs = stored.begin_parse();
  int declared = cs~load_uint(32);
  cell chain = cs~load_ref();
  cs.end_parse();
  throw_unless(pq::error::key_length, declared == pq::public_key_bytes(algorithm_id));
  throw_unless(pq::error::malformed_key, pq::chain_bytes(chain) == declared);
  return (declared, chain);
}

;; SHA-256("TOS-PQ-CONSENSUS-KEY-v1" || u16_le(algorithm_id) || key bytes).
;;
;; The algorithm number contributes two LITTLE-endian bytes -- suite 1 is `01 00` -- while
;; every other field on this wire is big-endian. Writing it the other way produces an
;; identity the node will not agree with, and nothing else would notice.
int pq::key_id(int algorithm_id, cell stored) {
  (_, cell chain) = pq::stored_key(algorithm_id, stored);
  int little_endian = ((algorithm_id & 0xff) << 8) | ((algorithm_id >> 8) & 0xff);
  return begin_cell()
    .store_slice("TOS-PQ-CONSENSUS-KEY-v1")
    .store_uint(little_endian, 16)
    .store_ref(chain)
  .end_cell().snake_string_hash();
}

;; validator_pq#b3 validator_id:bits256 algorithm_id:uint16 key_id:bits256
;;   public_key:^Cell weight:uint64 adnl_addr:bits256 = ValidatorDescr;
;;
;; The key identity is re-derived rather than believed, and the transport address is
;; required: a consensus key is never a transport identity, so nothing here invents one.
(int, int, int, cell, int, int) pq::parse_descriptor(slice cs) {
  throw_unless(pq::error::tag, cs~load_uint(8) == pq::descriptor_tag);
  int validator_id = cs~load_uint(256);
  int algorithm_id = cs~load_uint(16);
  int key_id = cs~load_uint(256);
  cell public_key = cs~load_ref();
  int weight = cs~load_uint(64);
  int adnl_addr = cs~load_uint(256);
  cs.end_parse();
  throw_if(pq::error::zero_validator_id, validator_id == 0);
  throw_if(pq::error::zero_adnl, adnl_addr == 0);
  throw_if(pq::error::zero_weight, weight == 0);
  throw_unless(pq::error::key_id, key_id == pq::key_id(algorithm_id, public_key));
  return (validator_id, algorithm_id, key_id, public_key, weight, adnl_addr);
}

;; The key identity is derived here too, so a descriptor this builds is one this parses.
builder pq::pack_descriptor(int validator_id, int algorithm_id, cell public_key, int weight, int adnl_addr) {
  throw_if(pq::error::zero_validator_id, validator_id == 0);
  throw_if(pq::error::zero_adnl, adnl_addr == 0);
  throw_if(pq::error::zero_weight, weight == 0);
  int key_id = pq::key_id(algorithm_id, public_key);
  return begin_cell()
    .store_uint(pq::descriptor_tag, 8)
    .store_uint(validator_id, 256)
    .store_uint(algorithm_id, 16)
    .store_uint(key_id, 256)
    .store_ref(public_key)
    .store_uint(weight, 64)
    .store_uint(adnl_addr, 256);
}

;; The frozen signature domains, as the cells PQCHECKSIG_MLDSA44 takes for its context.
;; Stated once so no caller writes a domain by hand.
cell pq::election_context() inline {
  return begin_cell().store_slice("TOS-VALIDATOR-ELECTION-v1").end_cell();
}

cell pq::config_vote_context() inline {
  return begin_cell().store_slice("TOS-VALIDATOR-CONFIG-VOTE-v1").end_cell();
}

;; ---------------------------------------------------------------------------
;; Elector state: a member is a controller account, and a key belongs to one of them
;;
;; Membership is keyed by the stable validator identity, which is the controlling account
;; the elector saw, so rotating a key does not move a validator in or out of the set. The
;; reverse index exists for the other direction: two controllers must not register the
;; same consensus key, because the set that would produce is one the node refuses for
;; duplicate key identity.
;; ---------------------------------------------------------------------------

const int pq::error::key_owned = 68;

;; stake:Tomis registered_at:uint32 max_factor:uint32 algorithm_id:uint16 key_id:uint256
;;   public_key:^Cell adnl_addr:uint256
builder pq::pack_member(int stake, int registered_at, int max_factor, int algorithm_id, int key_id,
                        cell public_key, int adnl_addr) inline {
  return begin_cell()
    .store_tomis(stake)
    .store_uint(registered_at, 32)
    .store_uint(max_factor, 32)
    .store_uint(algorithm_id, 16)
    .store_uint(key_id, 256)
    .store_ref(public_key)
    .store_uint(adnl_addr, 256);
}

(int, int, int, int, int, cell, int) pq::unpack_member(slice ms) inline {
  int stake = ms~load_tomis();
  int registered_at = ms~load_uint(32);
  int max_factor = ms~load_uint(32);
  int algorithm_id = ms~load_uint(16);
  int key_id = ms~load_uint(256);
  cell public_key = ms~load_ref();
  int adnl_addr = ms~load_uint(256);
  ms.end_parse();
  return (stake, registered_at, max_factor, algorithm_id, key_id, public_key, adnl_addr);
}

;; Registers a controller's key, or replaces the one it already registered, moving the
;; reverse index with it.
;;
;; Both directions are decided here, together, because they are one fact: a key belongs to
;; a controller. Updating the member record without the reverse index would let a released
;; key stay claimed; updating the reverse index without the member record would leave a
;; validator holding a key the index says is someone else's. A caller cannot get half of
;; this, because a refusal throws and the transaction commits nothing.
(cell, cell) pq::register_member(cell members, cell key_owner, int validator_id, int stake, int registered_at,
                                 int max_factor, int algorithm_id, cell public_key, int adnl_addr) {
  throw_if(pq::error::zero_validator_id, validator_id == 0);
  throw_if(pq::error::zero_adnl, adnl_addr == 0);
  int key_id = pq::key_id(algorithm_id, public_key);

  ;; A key already claimed by another controller is refused before anything is written.
  (slice owner, int claimed) = key_owner.udict_get?(256, key_id);
  if (claimed) {
    throw_unless(pq::error::key_owned, owner~load_uint(256) == validator_id);
  }

  ;; A controller that is rotating releases the key it held, so the index never keeps a
  ;; key nobody is registered with.
  (slice existing, int registered) = members.udict_get?(256, validator_id);
  if (registered) {
    (_, _, _, _, int held_key_id, _, _) = pq::unpack_member(existing);
    if (held_key_id != key_id) {
      key_owner~udict_delete?(256, held_key_id);
    }
  }

  key_owner~udict_set_builder(256, key_id, begin_cell().store_uint(validator_id, 256));
  members~udict_set_builder(256, validator_id,
    pq::pack_member(stake, registered_at, max_factor, algorithm_id, key_id, public_key, adnl_addr));
  return (members, key_owner);
}

;; Which controller holds a key, or zero. Zero is not a validator identity, so it cannot
;; be mistaken for an answer.
int pq::key_holder(cell key_owner, int key_id) inline {
  (slice owner, int claimed) = key_owner.udict_get?(256, key_id);
  return claimed ? owner~load_uint(256) : 0;
}
